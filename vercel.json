{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.minicuration.com"
        }
      ],
      "destination": "https://minicuration.com/:path*",
      "permanent": true
    },
    {
      "source": "/artists",
      "destination": "/artists/jfeelgood.html",
      "permanent": true
    },
    {
      "source": "/artists/",
      "destination": "/artists/jfeelgood.html",
      "permanent": true
    },
    {
      "source": "/artists/index.html",
      "destination": "/artists/jfeelgood.html",
      "permanent": true
    }
  ]
}
