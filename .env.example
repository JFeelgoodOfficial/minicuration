# Copy this file to .env.local and fill in the values. .env.local is ignored by
# git — create it on your own computer with a text editor, never through the
# GitHub website (the website ignores .gitignore and will commit it).

# Google Sheets — where inventory and orders live.
# One-time setup: console.cloud.google.com → new project → enable the "Google
# Sheets API" → Credentials → create a Service Account → Keys → add key (JSON).
# Then open your spreadsheet and Share it with the service account's email
# address, as an Editor.
GOOGLE_SHEETS_ID=                 # the /d/<this-part>/edit bit of the sheet's URL
GOOGLE_SERVICE_ACCOUNT_EMAIL=     # something@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=               # "private_key" from the JSON file, newlines written as \n

# Stripe — Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_BUNDLE_LINK_ID=plink_...   # six-pack Payment Link — deactivated when any edition sells out

# Resend — resend.com → API Keys (optional — order emails)
RESEND_API_KEY=re_...
ORDER_NOTIFY_EMAIL=support@minicuration.com   # where new-order alerts go
