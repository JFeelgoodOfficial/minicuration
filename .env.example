# Storage backend — 'sheets' (default) or 'supabase'
# The Supabase project is paused to free up a free-tier slot; inventory and the
# sales ledger live in a Google Spreadsheet instead. Flip this back to
# 'supabase' and redeploy to return to Postgres.
STORE_BACKEND=sheets

# Google Sheets (STORE_BACKEND=sheets)
# Create a service account in Google Cloud, enable the Google Sheets API, then
# share the spreadsheet with the service account's email as an Editor.
GOOGLE_SHEETS_ID=                 # the /d/<this-part>/edit segment of the sheet URL
GOOGLE_SERVICE_ACCOUNT_EMAIL=     # something@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=               # the JSON key's private_key, newlines as \n

# Supabase (STORE_BACKEND=supabase) — Settings → API
# Unused while paused; kept so the swap back is a config change, not a revert.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJ...       # "service_role" key — never expose client-side

# Stripe — Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_BUNDLE_LINK_ID=plink_...   # six-pack Payment Link — deactivated when any edition sells out

# Resend — resend.com → API Keys (optional — order + fulfillment emails)
RESEND_API_KEY=re_...
ORDER_NOTIFY_EMAIL=support@minicuration.com   # where new-order and action-needed alerts go

# Admin — long random string, guards /api/ship and admin.html
ADMIN_TOKEN=
