# Copy this file to .env.local and fill in the values. .env.local is ignored by
# git, and `npm run db:setup` reads it automatically.

# Neon — the database.
# neon.com → your project → Connection string. Copy the POOLED one (its host
# has "-pooler" in it) and paste the whole line, password and all.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Supabase — only needed for the one-off copy of your existing orders into Neon.
# supabase.com → your project → Settings → API. You want the "service_role" key,
# not the anon one. Delete both lines once the move is done; nothing in api/
# reads them.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Stripe — Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_BUNDLE_LINK_ID=plink_...   # six-pack Payment Link — deactivated when any edition sells out

# Resend — resend.com → API Keys (optional — order + fulfillment emails)
RESEND_API_KEY=re_...
ORDER_NOTIFY_EMAIL=support@minicuration.com   # where new-order and action-needed alerts go

# Admin — long random string, guards /api/ship and admin.html
ADMIN_TOKEN=
