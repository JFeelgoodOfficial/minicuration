# Neon — the Postgres database (Console → your project → Connection string)
# Use the POOLED connection string; the serverless driver talks over HTTPS, so
# no pooler process is needed on our side. Vercel's Neon integration sets this
# for you if you connect the project through the marketplace.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Supabase — only needed once, by scripts/migrate-to-neon.js, and only until
# the move is done. Not read by anything in api/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJ...       # "service_role" key — never expose client-side

# Stripe — Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_BUNDLE_LINK_ID=plink_...   # six-pack Payment Link — deactivated when any edition sells out

# Resend — resend.com → API Keys (optional — order + fulfillment emails)
RESEND_API_KEY=re_...
ORDER_NOTIFY_EMAIL=support@minicuration.com   # where new-order and action-needed alerts go

# Admin — long random string, guards /api/ship and admin.html
ADMIN_TOKEN=
